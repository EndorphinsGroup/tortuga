---
/** Ближайшие слоты из Telegram-бота (/api/schedule). Блок скрыт, пока расписание пустое. */
import Section from './Section.astro';
import site from '../data/site.json';
interface Props { kind?: 'surf' | 'plank'; light?: string; }
const { kind = '', light = 'уроки' } = Astro.props;
---
<div class="sched" data-kind={kind} data-bot={site.bot.href} hidden>
  <Section rail="Расписание" bold="Ближайшие" light={light} lead="Обновляем каждый день под прогноз. Выберите время — подтвердим место в Telegram.">
    <div class="sched__list"></div>
  </Section>
</div>

<style>
  .sched__list { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 190px), 1fr)); gap: var(--gap); }
  @media (max-width: 600px) { .sched__list { grid-template-columns: 1fr 1fr; } }
  :global(.slot) { display: flex; flex-direction: column; gap: 4px; padding: clamp(14px, 3vw, 18px); border-radius: var(--r-m); background: var(--cream); box-shadow: inset 0 0 0 1px var(--line); color: var(--ink); text-decoration: none; transition: box-shadow .2s, transform .2s; }
  :global(.slot:hover), :global(.slot:focus-visible) { box-shadow: inset 0 0 0 2px var(--terra); transform: translateY(-2px); }
  :global(.slot__day) { font-size: var(--fs-small); color: var(--muted); }
  :global(.slot__time) { font-size: clamp(22px, 5vw, 28px); font-weight: 700; line-height: 1.1; font-variant-numeric: tabular-nums; }
  :global(.slot__kind) { font-size: var(--fs-small); }
  :global(.slot__go) { margin-top: auto; padding-top: 8px; font-size: var(--fs-small); font-weight: 600; color: var(--terra); }
  @media (prefers-reduced-motion: reduce) { :global(.slot) { transition: none; } }
</style>

<script>
  const WD = ['Вс', 'Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб'];
  const KIND: Record<string, string> = { surf: 'Урок серфинга', plank: 'Светящийся планктон' };
  const places = (n: number) => `${n} ${n === 1 ? 'место' : n < 5 ? 'места' : 'мест'}`;
  type Slot = { id: string; kind: string; date: string; time: string; seats: number | null };

  fetch('/api/schedule').then((r) => (r.ok ? r.json() : { slots: [] })).then(({ slots }: { slots: Slot[] }) => {
    document.querySelectorAll<HTMLElement>('.sched').forEach((sec) => {
      const list = slots.filter((s) => !sec.dataset.kind || s.kind === sec.dataset.kind).slice(0, 8);
      if (!list.length) return;
      sec.querySelector('.sched__list')!.replaceChildren(...list.map((s) => {
        const d = new Date(s.date + 'T00:00:00Z');
        const a = document.createElement('a');
        a.className = 'slot'; a.target = '_blank'; a.rel = 'noopener';
        a.href = `${sec.dataset.bot}?start=s-${s.id}`; a.dataset.goal = `tg_slot_${s.kind}`;
        a.innerHTML = `<span class="slot__day">${WD[d.getUTCDay()]}, ${s.date.slice(8)}.${s.date.slice(5, 7)}</span>`
          + `<span class="slot__time">${s.time}</span>`
          + `<span class="slot__kind">${KIND[s.kind] ?? ''}${s.seats ? ` · ${places(s.seats)}` : ''}</span>`
          + `<span class="slot__go">Записаться →</span>`;
        return a;
      }));
      sec.hidden = false;
    });
  }).catch(() => {});
</script>
