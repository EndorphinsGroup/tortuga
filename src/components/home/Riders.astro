---
import prices from '../../data/prices.json';
interface Props { img?: string; alt?: string; flip?: boolean; }
const { img = '/img/bg-couple.webp', alt = 'Двое сёрферов в гидрокостюмах идут по кромке воды с досками', flip = true } = Astro.props;
---
<section id="arenda" class="sec">
  <span class="sec__rail">Если уже катаетесь</span>
  <div class="wrap photo-bg riders">
    <img class:list={['photo-bg__img', { flip }]} src={img} alt={alt} loading="lazy">
    <span class="photo-bg__shade"></span>
    <h2 class="h2">Катаетесь сами? <span class="l">Приезжайте к нам</span></h2>
    <p class="riders__lead">База на Бай Дай — удобная точка, если вы приезжаете кататься сами: парковка под присмотром, место, где оставить вещи, отдохнуть и поесть после сессии.</p>
    <div class="riders__grid">
      {prices.riders.map((r) => <div class="glass"><b>{r.title}</b><span>{r.text}</span></div>)}
    </div>
  </div>
</section>

<style>
  .riders { border-radius: 32px; padding: clamp(32px, 5vw, 64px); min-height: 560px; display: flex; flex-direction: column; justify-content: flex-end; }
  .riders > .photo-bg__img.flip { transform: scaleX(-1); }
  .riders > .photo-bg__shade { background: linear-gradient(90deg, rgb(var(--shade) / .88) 0%, rgb(var(--shade) / .58) 45%, rgb(var(--shade) / .05) 75%), linear-gradient(0deg, rgb(var(--shade) / .6) 0%, transparent 35%); }
  .riders .h2 { max-width: 15ch; }
  .riders__lead { margin-top: 18px; max-width: 56ch; font-size: 18px; color: var(--on-dark); }
  .riders__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; margin-top: 28px; }
  .riders__grid b { display: block; font-size: 20px; }
  .riders__grid span { font-size: 15px; color: var(--on-dark); }
  @media (max-width: 700px) {
    .riders > .photo-bg__shade { background: linear-gradient(0deg, rgb(var(--shade) / .94) 0%, rgb(var(--shade) / .6) 100%); }
  }
</style>
