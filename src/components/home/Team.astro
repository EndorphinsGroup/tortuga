---
import Section from '../Section.astro';
const team = [
  ['Евгения', 'Основатель школы. Русский, английский.', '/img/ph-jump.webp'],
  ['Максим', 'КМС по плаванию. Русский, английский.', '/img/ph-blond.webp'],
  ['Михаил', 'Сертифицированный инструктор. Русский, английский.', '/img/ph-water.webp'],
  ['Кирилл', 'Инструктор. Русский, английский.', '/img/ph-bald.webp'],
];
---
<Section rail="Инструкторы" bold="Кто будет" light="рядом в воде">
  <div class="grid" style="--min: 220px">
    {team.map(([name, about, img]) => (
      <div class="person">
        <img src={img} alt={`[Фото: ${name}]`} loading="lazy">
        <h3 class="h3">{name}</h3>
        <p class="muted">{about}</p>
      </div>
    ))}
  </div>
</Section>

<style>
  .person img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; border-radius: var(--r-l); }
  .person .h3 { margin-top: 16px; }
  .person p { margin-top: 4px; font-size: 15px; }
</style>
