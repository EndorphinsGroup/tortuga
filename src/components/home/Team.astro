---
import Section from '../Section.astro';
const team = [
  ['Евгения', '/img/t-evgeniya.webp'],
  ['Максим', '/img/t-maksim.webp'],
  ['Михаил', '/img/t-mihail.webp'],
  ['Кирилл', '/img/t-kirill.webp'],
];
---
<Section rail="Инструкторы" bold="Кто будет" light="рядом в воде">
  <div class="grid" style="--min: 220px">
    {team.map(([name, img]) => (
      <div class="person">
        <img src={img} alt={`${name}, инструктор школы Tortuga`} loading="lazy">
        <h3 class="h3">{name}</h3>
      </div>
    ))}
  </div>
</Section>

<style>
  .person img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; border-radius: var(--r-l); }
  .person .h3 { margin-top: 16px; }
</style>
