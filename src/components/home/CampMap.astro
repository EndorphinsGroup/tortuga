---
import Section from '../Section.astro';
const zones = [
  { id: 'base', name: 'Домик', left: 15.2, top: 48.8, img: '/img/z-base.webp', alt: 'Домик базы: стеклянный фасад, SUP-доски у стены',
    text: 'Здесь переодеваются, подбирают лайкру или гидрокостюм и оставляют вещи на время урока. После воды — горячий душ.',
    chips: ['Горячий душ', 'Туалет', 'Переодевалка', 'Хранение вещей', 'Парковка байков'] },
  { id: 'lounge', name: 'Лаундж', left: 43.9, top: 76.9, img: '/img/z-lounge.webp', alt: 'Лаундж под навесом у домика: кресла и диваны с подушками',
    text: 'Терраса под навесом: диванчики, гамаки, кухня. Тут обедают после урока, знакомятся и ждут трансфер. Рядом обычно дремлет Калипсо — риджбек базы.',
    chips: ['Тень', 'Wi-Fi', 'Кухня', 'Вегетарианское меню'] },
  { id: 'bbq', name: 'Гриль', left: 53.8, top: 56.8, img: '/img/z-bbq.webp', alt: 'Беседка с круглым столом, барной стойкой и каменным грилем',
    text: 'Беседка в глубине сада: каменный гриль, барная стойка и большой круглый стол. После ночной SUP-прогулки к светящемуся планктону здесь накрывают BBQ-ужин.',
    chips: ['BBQ-ужин', 'Стол на компанию'], link: { href: '/svetyashchijsya-plankton/', label: 'ночная экскурсия к светящемуся планктону' } },
  { id: 'surf', name: 'Серф-пойнт', left: 42.9, top: 9.8, img: '/img/z-surf.webp', alt: 'Пляж с досками для серфинга и зонтом',
    text: 'Из арки — направо по дороге, и через пару минут пляж. Песчаное дно, пологий вход, новички учатся в пене у берега. Пока вы в воде, близкие ждут в тени.',
    chips: ['Душ', 'Туалет', 'Переодевалка', 'Шезлонги в тени', 'Бар и Wi-Fi', 'Спасатель и аптечка'] },
  { id: 'parking', name: 'Парковка', left: 69.5, top: 86,
    text: 'Байк оставляете на базе — за забором и под присмотром, а не на пляже, откуда их угоняют. До серф-пойнта пара минут пешком.',
    chips: ['Под присмотром', 'За забором', 'Камеры'] },
  { id: 'kalipso', name: 'Калипсо', left: 31.8, top: 64,
    text: 'Риджбек, который живёт на базе. Днём обычно дремлет в тени у лаунджа и встречает гостей. Со своим дружелюбным питомцем приезжать тоже можно — только предупредите заранее.',
    chips: ['Живёт на базе', 'Можно с питомцами'] },
];
---
<Section id="base" rail="База" bold="Наша" light="база" lead="Домик с горячим душем, лаундж с кухней и гриль в тропическом саду. До пляжа пара минут по дороге. Нажмите на точку.">
  <div class="split camp">
    <div class="main camp__map">
      <div class="camp__in">
        <img src="/img/map-camp.webp" alt="Иллюстрация базы Tortuga: арка у дороги, домик слева, лаундж и беседка с грилем в саду, серф-пойнт на пляже за деревьями" loading="lazy">
        {zones.map((z, i) => (
          <button type="button" class:list={['spot', { 'spot--right': z.right }]} data-zone={z.id} aria-pressed={String(i === 0)} style={`left:${z.left}%;top:${z.top}%`}>
            <span class="spot__dot"><span class="spot__ping"></span></span><span class="spot__name">{z.name}</span>
          </button>
        ))}
      </div>
    </div>
    <div class="camp__tabs" role="tablist" aria-label="Зоны базы">
      {zones.map((z, i) => <button type="button" role="tab" data-zone={z.id} aria-selected={String(i === 0)}>{z.name}</button>)}
    </div>
    <div class="side camp__card">
      {zones.map((z, i) => (
        <div class="zone" data-zone={z.id} hidden={i !== 0}>
          {z.img && <img src={z.img} alt={z.alt} loading="lazy">}
          <div class="zone__body">
            <h3 class="h3">{z.name}</h3>
            <p>{z.text}</p>
            <ul class="chips">{z.chips.map((c) => <li class="chip">{c}</li>)}</ul>
            {z.link && <a class="link" href={z.link.href}>{z.link.label}</a>}
          </div>
        </div>
      ))}
    </div>
  </div>
</Section>

<style>
  .camp__map { border-radius: var(--r-l); overflow: hidden; align-self: flex-start; }
  .camp__in { position: relative; aspect-ratio: 1900 / 1070; }
  .camp__in > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .spot { position: absolute; transform: translate(-8px, -50%); display: flex; align-items: center; gap: 6px; border: 0; padding: 0; background: none; cursor: pointer; font: inherit; }
  .spot--right { flex-direction: row-reverse; transform: translate(calc(-100% + 8px), -50%); }
  .spot__dot { position: relative; width: 16px; height: 16px; border-radius: 50%; flex: none; background: var(--terra); box-shadow: 0 0 0 3px rgb(255 255 255 / .95), 0 6px 16px rgb(var(--shade) / .35); }
  .spot__ping { position: absolute; inset: -3px; border-radius: 50%; border: 2px solid var(--terra); animation: ping 2.2s ease-out infinite; }
  .spot__name { font-size: 13px; font-weight: 500; padding: 4px 10px; border-radius: var(--pill); background: var(--cream); color: var(--ink); box-shadow: 0 6px 16px rgb(var(--shade) / .25); white-space: nowrap; }
  .spot[aria-pressed="true"] .spot__dot { background: var(--sea); box-shadow: 0 0 0 3px var(--terra), 0 6px 16px rgb(var(--shade) / .35); }
  .spot[aria-pressed="true"] .spot__ping { display: none; }
  .spot[aria-pressed="true"] .spot__name { background: var(--sea); color: #fff; }
  @keyframes ping { from { transform: scale(1); opacity: .9; } to { transform: scale(2.4); opacity: 0; } }
  .camp__card { background: var(--sand-2); border-radius: var(--r-l); overflow: hidden; }
  .zone > img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; }
  .zone__body { padding: 24px; display: flex; flex-direction: column; gap: 14px; font-size: 16px; color: var(--ink-soft); }
  .zone__body .h3 { font-size: 26px; color: var(--ink); }
  .zone:not([hidden]) { animation: zin .28s ease-out; }
  @keyframes zin { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  .camp__tabs { display: none; }
  @media (max-width: 700px) {
    .camp__map { overflow-x: auto; scrollbar-width: none; scroll-behavior: smooth; }
    .camp__map::-webkit-scrollbar { display: none; }
    .camp__in { width: 200%; }
    .spot__name { display: none; }
    .camp__tabs { display: flex; flex: 1 1 100%; gap: 6px; overflow-x: auto; scrollbar-width: none; }
    .camp__tabs button { flex: none; height: 44px; padding: 0 16px; border-radius: var(--pill); border: 0; background: var(--sand-2); color: var(--ink); font: 500 15px var(--font); cursor: pointer; }
    .camp__tabs button[aria-selected="true"] { background: var(--sea); color: #fff; }
  }
</style>

<script>
  const map = document.querySelector<HTMLElement>('.camp__map')!;
  const center = (id: string) => {
    if (map.scrollWidth <= map.clientWidth) return;
    const s = document.querySelector<HTMLElement>(`.spot[data-zone="${id}"]`)!;
    map.scrollLeft = s.offsetLeft - map.clientWidth / 2;
  };
  const show = (id: string) => {
    document.querySelectorAll('.spot').forEach((s) => s.setAttribute('aria-pressed', String((s as HTMLElement).dataset.zone === id)));
    document.querySelectorAll('.camp__tabs [role=tab]').forEach((t) => t.setAttribute('aria-selected', String((t as HTMLElement).dataset.zone === id)));
    document.querySelectorAll<HTMLElement>('.zone').forEach((z) => { z.hidden = z.dataset.zone !== id; });
    center(id);
  };
  document.querySelectorAll<HTMLElement>('.spot, .camp__tabs [role=tab]').forEach((b) => b.addEventListener('click', () => show(b.dataset.zone!)));
  requestAnimationFrame(() => { map.style.scrollBehavior = 'auto'; center('base'); map.style.scrollBehavior = ''; });
</script>
