---
import Section from '../Section.astro';
import Icon from '../Icon.astro';
import prices from '../../data/prices.json';
interface Props { learn?: boolean; id?: string; bold?: string; light?: string; }
const { learn = true, id = 'passes', bold = 'Абонементы', light = 'и курсы' } = Astro.props;
---
<Section id={id} rail="Абонементы и курсы" bold={bold} light={light} lead="Больше практики — быстрее результат. Цены за человека, абонемент действует 2 месяца.">
  <div class="passes" role="region" aria-label="Цены абонементов" tabindex="0">
    <table>
      <thead><tr><th scope="col">Формат</th>{prices.passes.columns.map((c) => <th scope="col">{c}</th>)}</tr></thead>
      <tbody>
        {prices.passes.rows.map((r) => (
          <tr>
            <th scope="row"><b>{r.title}</b><span>{r.sub}</span></th>
            {r.cells.map((c, i) => c ? <td data-label={prices.passes.columns[i]}><b>{c[0]}{c[1] && ' ₫'}</b>{c[1] && <span>≈ ${c[1]}</span>}</td> : <td class="passes__none" data-label={prices.passes.columns[i]}>—</td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {learn && <div class="learn">
    <div class="card learn__steps">
      <h3 class="h3">Что даёт каждый курс</h3>
      <ol>
        {prices.course.map((c) => (
          <li><span class="learn__n">{c.n}</span><span><b>{c.title}</b>{c.text}</span></li>
        ))}
      </ol>
    </div>
    <div class="card card--peach learn__skills">
      <h3 class="h3">Чему вы научитесь</h3>
      <ul>
        {prices.skills.map((s) => <li><Icon name="check" size={20} /><span>{s}</span></li>)}
      </ul>
      <p class="learn__note">Главное для первых шагов — ваше желание и умение плавать. Хорошая физическая форма поможет быстрее, но быть спортсменом не обязательно.</p>
    </div>
  </div>}
</Section>

<style>
  .passes { overflow-x: auto; border-radius: var(--r-l); background: var(--sand-2); }
  .passes table { width: 100%; min-width: 760px; border-collapse: collapse; }
  .passes th, .passes td { padding: 18px 22px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--line); }
  .passes tr:last-child th, .passes tr:last-child td { border-bottom: 0; }
  .passes thead th { font-size: 14px; font-weight: 500; color: var(--muted); }
  .passes tbody th b, .passes td b { display: block; font-size: 19px; color: var(--ink); white-space: nowrap; }
  .passes tbody th span, .passes td span { font-size: 14px; color: var(--muted); font-weight: 400; }
  .passes__none { color: var(--muted-2); }
  @media (max-width: 700px) {
    .passes { background: none; overflow: visible; }
    .passes table { min-width: 0; }
    .passes thead { display: none; }
    .passes tr { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; background: var(--sand-2); border-radius: var(--r-m); padding: 16px; margin-bottom: 10px; }
    .passes tbody th { grid-column: 1 / -1; padding: 0; border: 0; }
    .passes td { padding: 0; border: 0; }
    .passes td::before { content: attr(data-label); display: block; font-size: 12px; color: var(--muted); }
    .passes td b { font-size: 15px; }
    .passes__none { display: none; }
  }

  .learn { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: var(--gap); margin-top: var(--gap); }
  .learn .card { padding: 28px; }
  .learn ol, .learn ul { list-style: none; margin: 18px 0 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .learn__steps li { display: flex; gap: 14px; align-items: flex-start; font-size: 15px; color: var(--ink-soft); }
  .learn__steps b { display: block; color: var(--ink); font-size: 17px; }
  .learn__n { flex: none; width: 36px; height: 36px; border-radius: 50%; background: var(--sea); color: #fff; display: grid; place-items: center; font-weight: 700; font-size: 15px; }
  .learn__skills li { display: flex; gap: 10px; align-items: flex-start; font-size: 16px; color: var(--ink-soft); }
  .learn__skills li :global(svg) { flex: none; color: var(--sea); margin-top: 2px; }
  .learn__note { margin-top: 20px; font-size: 15px; color: var(--muted); }
</style>
