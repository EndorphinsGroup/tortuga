---
import Section from '../Section.astro';
import faq from '../../data/faq.json';
interface Props { items?: { q: string; a: string }[]; more?: { label: string; href: string }; }
const { items = faq, more = { label: 'все вопросы о серфинге и экскурсии', href: '/faq/' } } = Astro.props;
---
<Section id="faq" rail="Вопросы" bold="Частые" light="вопросы">
  <div class="faq">
    {items.map((f) => (
      <details><summary>{f.q}<span class="faq__plus" aria-hidden="true">+</span></summary><p>{f.a}</p></details>
    ))}
  </div>
  <a class="link more" href={more.href}>{more.label}</a>
</Section>

<style>
  .faq { max-width: 980px; }
  details { border-top: 1px solid var(--line); }
  details:last-child { border-bottom: 1px solid var(--line); }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; gap: 16px; padding: 24px 0; font-size: clamp(19px, 1.7vw, 23px); font-weight: 600; }
  summary::-webkit-details-marker { display: none; }
  .faq__plus { font-weight: 300; transition: transform .2s; }
  details[open] .faq__plus { transform: rotate(45deg); }
  details p { padding: 0 0 24px; max-width: 66ch; color: var(--ink-soft); }
  .more { display: inline-block; margin-top: 24px; }
</style>
