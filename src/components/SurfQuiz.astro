---
/** Квиз «Подберём урок» — один на весь сайт. Логика и цены в src/lib/surfQuiz.ts; level задаёт стартовый ответ на странице. */
import site from '../data/site.json';
import { QUESTIONS, compute, type Level, type State } from '../lib/surfQuiz';
interface Props { id?: string; rail?: string; bold?: string; light?: string; level?: Level }
const { id = 'quiz', rail = 'Подбор', bold = 'Подберём', light = 'урок', level = 'new' } = Astro.props;
const init: State = { level, who: 'solo', stay: 'two', pl: false };
const r = compute(init);
const href = (code: string) => `${site.bot.href}?start=${code}`;
---
<section id={id} class="sec">
  <span class="sec__rail">{rail}</span>
  <div class="wrap sq" data-sq={JSON.stringify({ init, bot: site.bot.href })}>
    <div class="sq__q">
      <h2 class="h2">{bold}{light && <span class="l"> {light}</span>}</h2>
      {QUESTIONS.map((q) => (
        <fieldset>
          <legend>{q.legend}</legend>
          <div class="sq__opts">
            {q.options.map(([v, t]) => <button type="button" class="sq__o" data-q={q.key} data-v={v} aria-pressed={String(init[q.key as keyof State] === v)}>{t}</button>)}
          </div>
        </fieldset>
      ))}
    </div>
    <div class="sq__rec" aria-live="polite">
      <span class="sq__hint">Вам подойдёт</span>
      <b class="sq__title" data-r="title">{r.title}</b>
      <span class="sq__price" data-r="price">{r.price}</span>
      <p data-r="text">{r.text}</p>
      <p class="sq__extra" data-r="extra">{r.extra}</p>
      <label class="sq__pl">
        <input type="checkbox" data-pl>
        <span><b>+ вечер со светящимся планктоном</b><br><span class="sq__muted" data-r="plankton">{r.plankton}</span></span>
      </label>
      <span class="sq__total" data-r="total">{r.total}</span>
      <a class="btn btn--primary" href={href(r.code)} target="_blank" rel="noopener" data-goal={`tg_quiz_${id}`} data-r="link">Записаться</a>
      <span class="sq__muted sq__alt" data-r="alt">{r.alt}</span>
    </div>
  </div>
</section>

<style>
  .sq { background: var(--sea); color: #fff; border-radius: 32px; padding: clamp(28px, 4vw, 56px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 40px; }
  .sq .h2 { font-size: clamp(32px, 4vw, 60px); }
  .sq__q { display: flex; flex-direction: column; gap: 28px; }
  fieldset { border: 0; margin: 0; padding: 0; }
  legend { font-weight: 600; margin-bottom: 12px; padding: 0; }
  .sq__opts { display: flex; flex-wrap: wrap; gap: 8px; }
  .sq__o { height: 44px; padding: 0 18px; border-radius: var(--pill); border: 0; font: 500 15px var(--font); cursor: pointer; background: rgb(255 255 255 / .1); color: #fff; box-shadow: inset 0 0 0 1px rgb(255 255 255 / .3); }
  .sq__o[aria-pressed="true"] { background: var(--terra); box-shadow: none; }
  .sq__rec { background: rgb(255 255 255 / .08); box-shadow: inset 0 0 0 1px rgb(255 255 255 / .16); border-radius: var(--r-l); padding: 32px; display: flex; flex-direction: column; gap: 14px; color: var(--on-dark-2); }
  .sq__hint { font-size: 15px; color: var(--sea-2); }
  .sq__title { font-size: clamp(22px, 2.4vw, 32px); line-height: 1.1; text-transform: uppercase; color: #fff; }
  .sq__price { font-size: 22px; font-weight: 700; color: #fff; }
  .sq__extra:empty, .sq__total:empty { display: none; }
  .sq__extra { font-size: 15px; color: var(--sea-2); }
  .sq__pl { display: flex; gap: 12px; align-items: flex-start; padding: 14px 16px; border-radius: var(--r-m); background: rgb(255 255 255 / .06); cursor: pointer; font-size: 15px; line-height: 1.4; }
  .sq__pl b { color: #fff; font-weight: 600; }
  .sq__pl input { width: 20px; height: 20px; margin: 1px 0 0; accent-color: var(--terra); flex: none; }
  .sq__muted { font-size: 14px; color: var(--sea-2); }
  .sq__total { font-size: 17px; font-weight: 600; color: #fff; }
  .sq__rec .btn { align-self: flex-start; margin-top: 4px; }
</style>

<script>
  import { compute, type State } from '../lib/surfQuiz';
  document.querySelectorAll<HTMLElement>('[data-sq]').forEach((box) => {
    const cfg = JSON.parse(box.dataset.sq!) as { init: State; bot: string };
    const st: State = { ...cfg.init };
    const $ = (k: string) => box.querySelector<HTMLElement>(`[data-r="${k}"]`)!;
    const render = () => {
      const r = compute(st);
      for (const k of ['title', 'price', 'text', 'extra', 'total', 'alt', 'plankton'] as const) $(k).textContent = r[k];
      ($('link') as HTMLAnchorElement).href = `${cfg.bot}?start=${r.code}`;
    };
    box.querySelectorAll<HTMLButtonElement>('.sq__o').forEach((b) => b.addEventListener('click', () => {
      (st as Record<string, unknown>)[b.dataset.q!] = b.dataset.v!;
      box.querySelectorAll(`.sq__o[data-q="${b.dataset.q}"]`).forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      render();
    }));
    box.querySelector<HTMLInputElement>('[data-pl]')!.addEventListener('change', (e) => { st.pl = (e.target as HTMLInputElement).checked; render(); });
  });
</script>
