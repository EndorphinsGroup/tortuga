---
/** Hero for inner pages: photo, breadcrumbs, two-weight H1, lead, buttons (slot), glass facts. */
import Crumbs from './Crumbs.astro';
interface Props {
  img: string; alt: string;
  crumbs: { label: string; href?: string }[];
  title: { text: string; light?: boolean }[];
  lead: string;
  facts?: [string, string][];
}
const { img, alt, crumbs, title, lead, facts = [] } = Astro.props;
---
<section class="phero photo-bg">
  <img class="photo-bg__img" src={img} alt={alt} fetchpriority="high">
  <span class="photo-bg__shade"></span>
  <Crumbs items={crumbs} dark />
  <div class="phero__body">
    <h1 class="phero__title">{title.map((t) => <span class:list={{ l: t.light }}>{t.text}</span>)}</h1>
    <p class="phero__lead">{lead}</p>
    <slot />
  </div>
  {facts.length > 0 && (
    <div class="phero__facts">{facts.map(([b, t]) => <div class="glass"><b>{b}</b>{t}</div>)}</div>
  )}
</section>

<style>
  .phero { border-radius: 0 0 var(--r-xl) var(--r-xl); min-height: min(calc(100vh - 74px), 760px); display: flex; flex-direction: column; padding: 24px var(--gutter) clamp(20px, 3.5vh, 36px) calc(var(--rail) + var(--gutter)); }
  .photo-bg__shade { background: linear-gradient(90deg, rgb(var(--shade) / .85) 0%, rgb(var(--shade) / .55) 50%, rgb(var(--shade) / .15) 85%), linear-gradient(0deg, rgb(var(--shade) / .6) 0%, transparent 40%); }
  .phero__body { flex: 1; display: flex; flex-direction: column; justify-content: center; padding: clamp(32px, 6vh, 72px) 0 0; }
  .phero__title { text-transform: uppercase; font-size: clamp(34px, min(5.4vw, 8.5vh), 88px); line-height: .96; letter-spacing: -.035em; font-weight: 800; }
  .phero__title span { display: block; }
  .phero__title .l { font-weight: 300; }
  .phero__lead { margin: clamp(14px, 2.6vh, 28px) 0 clamp(16px, 3vh, 32px); font-size: clamp(16px, 1.3vw, 19px); max-width: 52ch; color: var(--on-dark); }
  .phero__facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; margin-top: clamp(16px, 3vh, 32px); max-width: var(--max); font-size: 14px; line-height: 1.35; color: var(--on-dark); }
  .phero__facts b { display: block; color: #fff; font-size: 19px; margin-bottom: 2px; }
  @media (max-width: 900px) {
    .phero { min-height: calc(100svh - 74px); padding-left: var(--gutter); }
    .phero__facts { grid-template-columns: 1fr 1fr; }
  }
</style>
