---
import Section from '../Section.astro';
import Icon from '../Icon.astro';
import p from '../../data/plankton.json';
---
<Section rail="Как это было" bold="Как это" light="было у гостей">
  <div class="pm">
    <div class="reel">
      <img src="/img/r-plankton.webp" alt="" loading="lazy">
      <video src="/video/guest-plankton.mp4" preload="none" playsinline hidden></video>
      <button type="button" class="reel__play" aria-label="Смотреть видеоотзыв о ночной экскурсии к планктону"><Icon name="play" size={26} /></button>
      <span class="reel__cap">Видеоотзыв: ночная SUP-прогулка и BBQ</span>
    </div>
    <div class="pm__side">
      <blockquote class="card quote">
        {p.quote.map((q) => <p>«{q}»</p>)}
        <footer>— гость школы, видеоотзыв</footer>
      </blockquote>
      <div class="pm__grid">
        {p.media.map((m) => <figure><img src={m.img} alt={m.alt} loading="lazy"><figcaption>{m.cap}</figcaption></figure>)}
      </div>
    </div>
  </div>
</Section>

<style>
  .pm { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: var(--gap); }
  .reel { position: relative; border-radius: var(--r-l); overflow: hidden; min-height: 520px; background: var(--night); }
  .reel img, .reel video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .reel video { z-index: 2; background: #000; }
  .reel video[hidden] { display: none; }
  .reel__play { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 72px; height: 72px; border-radius: 50%; border: 0; background: var(--cream); color: var(--ink); display: grid; place-items: center; cursor: pointer; }
  .reel__cap { position: absolute; left: 14px; right: 14px; bottom: 14px; color: #fff; font-size: 15px; background: rgb(var(--shade) / .72); padding: 10px 14px; border-radius: 14px; }
  .reel.playing .reel__play, .reel.playing .reel__cap { display: none; }
  .pm__side { display: flex; flex-direction: column; gap: var(--gap); }
  .quote { margin: 0; padding: 28px; display: flex; flex-direction: column; gap: 12px; font-size: clamp(17px, 1.4vw, 20px); line-height: 1.45; }
  .quote footer { font-size: 14px; color: var(--muted); }
  .pm__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gap); flex: 1; }
  .pm__grid figure { margin: 0; position: relative; border-radius: var(--r-m); overflow: hidden; min-height: 180px; background: var(--night); }
  .pm__grid img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .pm__grid figcaption { position: absolute; left: 8px; right: 8px; bottom: 8px; font-size: 13px; color: #fff; background: rgb(var(--shade) / .7); padding: 6px 10px; border-radius: 10px; }
  @media (max-width: 1000px) { .pm { grid-template-columns: 1fr; } .reel { min-height: 560px; } }
  @media (max-width: 700px) { .pm__grid { grid-template-columns: 1fr 1fr; } .pm__grid figure { min-height: 140px; } .pm__grid figcaption { font-size: 11px; padding: 4px 8px; } }
</style>

<script>
  document.querySelectorAll('.pm .reel').forEach((r) => {
    const v = r.querySelector('video')!;
    r.querySelector('.reel__play')!.addEventListener('click', () => { r.classList.add('playing'); v.hidden = false; v.controls = true; v.play(); });
  });
</script>
