---
import Section from '../Section.astro';
import courses from '../../data/courses.json';
---
<Section id="slovar" rail="Словарь" bold="Словарь" light="сёрфера" lead="Слова, которые услышите от инструктора с первых уроков.">
  <dl class="gl">
    {courses.glossary.map(([t, d]) => <div><dt>{t}</dt><dd>{d}</dd></div>)}
  </dl>
</Section>

<style>
  .gl { margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap); }
  .gl div { padding: 24px; border-radius: var(--r-l); background: var(--sand-2); }
  .gl dt { font-size: 20px; font-weight: 700; margin-bottom: 8px; }
  .gl dd { margin: 0; font-size: 15px; color: var(--ink-soft); }
  @media (max-width: 1000px) { .gl { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .gl { grid-template-columns: 1fr; } .gl div { padding: 20px; } }
</style>
