---
import Section from '../Section.astro';
import Icon from '../Icon.astro';
import prices from '../../data/prices.json';
---
<Section rail="Что входит" bold="Что входит" light="в урок">
  <ul class="inc">
    {prices.included.map((i) => (
      <li class="card"><span class="inc__icon"><Icon name={i.icon} /></span><b>{i.title}</b><span>{i.text}</span></li>
    ))}
  </ul>
</Section>

<style>
  .inc { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 190px), 1fr)); gap: var(--gap); }
  .inc li { display: flex; flex-direction: column; gap: 4px; padding: 22px; font-size: 15px; color: var(--ink-soft); }
  .inc b { margin-top: 14px; font-size: 18px; color: var(--ink); }
  .inc__icon { width: 48px; height: 48px; border-radius: 50%; background: var(--sea); color: #fff; display: grid; place-items: center; }
</style>
