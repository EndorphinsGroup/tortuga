---
import Section from '../Section.astro';
import prices from '../../data/prices.json';
import lessons from '../../data/lessons.json';
import site from '../../data/site.json';
const names: Record<string, string> = { individual: 'Индивидуальный урок', pair: 'Парный урок', group: 'Групповой урок' };
const anchors: Record<string, string> = { individual: 'individualnyj', pair: 'parnyj', group: 'gruppovoj' };
const fmts = lessons.compare.formats.map((id) => prices.lessons.find((l) => l.id === id)!);
const msg = (t: string) => `${site.whatsapp.href}?text=${encodeURIComponent(`Здравствуйте! Хочу на ${t.toLowerCase().replace(' урок', ' урок серфинга')}, дата: `)}`;
---
<Section id="formaty" rail="Форматы и цены" bold="Форматы" light="уроков" lead={prices.note}>
  <div class="grid fmts" style="--min: 280px">
    {fmts.map((l) => (
      <article id={anchors[l.id]} class:list={['fmt', { 'fmt--featured': l.featured }]}>
        <div class="fmt__photo">
          <img src={l.img} alt={l.alt} loading="lazy">
          <span class:list={['badge', { 'badge--accent': l.featured }]}>{l.badge}</span>
        </div>
        <div class="fmt__body">
          <h3 class="h3">{names[l.id]}</h3>
          <p class="fmt__price">{l.vnd} ₫ <span>≈ ${l.usd}</span></p>
          <p>{l.text}</p>
          <p>{l.fit}</p>
          <div class="fmt__btns">
            <a class:list={['btn', l.featured ? 'btn--primary' : 'btn--dark']} href={site.telegram.href} target="_blank" rel="noopener" data-goal={`tg_lesson_${l.id}`}>Telegram</a>
            <a class:list={['btn', l.featured ? 'btn--light' : 'btn--outline']} href={msg(names[l.id])} target="_blank" rel="noopener" data-goal={`wa_lesson_${l.id}`}>WhatsApp</a>
          </div>
        </div>
      </article>
    ))}
  </div>

  <div class="cmp" role="region" aria-label="Сравнение форматов" tabindex="0">
    <table>
      <thead><tr><th scope="col"><span class="sr">Параметр</span></th>{fmts.map((l) => <th scope="col">{l.title}</th>)}</tr></thead>
      <tbody>
        {lessons.compare.rows.map((r) => (
          <tr><th scope="row">{r.label}</th>{r.values.map((v) => <td>{v}</td>)}</tr>
        ))}
        <tr><th scope="row">Цена с человека</th>{fmts.map((l) => <td><b>{l.vnd} ₫</b> ≈ ${l.usd}</td>)}</tr>
      </tbody>
    </table>
  </div>
</Section>

<style>
  .fmt { border-radius: var(--r-l); overflow: hidden; display: flex; flex-direction: column; background: var(--sand-2); scroll-margin-top: 90px; }
  .fmt--featured { background: var(--sea); color: #fff; }
  .fmt__photo { position: relative; aspect-ratio: 4 / 3; }
  .fmt__photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .fmt__photo .badge { position: absolute; left: 16px; top: 16px; }
  .fmt__body { padding: 24px 24px 26px; display: flex; flex-direction: column; gap: 12px; flex: 1; font-size: 15px; color: var(--ink-soft); }
  .fmt--featured .fmt__body { color: var(--on-dark-2); }
  .fmt__body .h3, .fmt__price { color: var(--ink); }
  .fmt--featured .fmt__body .h3, .fmt--featured .fmt__price { color: #fff; }
  .fmt__price { font-size: 26px; font-weight: 800; line-height: 1.1; letter-spacing: -.01em; white-space: nowrap; }
  .fmt__price span { font-size: 17px; font-weight: 500; opacity: .7; }
  .fmt__btns { margin-top: auto; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .fmt__btns .btn { padding: 0 12px; }
  .fmt--featured .btn--light { background: rgb(255 255 255 / .14); color: #fff; box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / .6); }

  .cmp { margin-top: var(--gap); overflow-x: auto; border-radius: var(--r-l); background: var(--cream); }
  .cmp table { width: 100%; min-width: 720px; border-collapse: collapse; font-size: 15px; }
  .cmp th, .cmp td { padding: 16px 22px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--line); }
  .cmp tr:last-child > * { border-bottom: 0; }
  .cmp thead th { font-size: 17px; font-weight: 700; }
  .cmp thead th:nth-child(2), .cmp td:nth-child(2) { background: rgb(30 77 87 / .07); }
  .cmp tbody th { font-weight: 500; color: var(--muted); width: 24%; }
  .cmp td { color: var(--ink-soft); }
  .cmp td b { color: var(--ink); }
  @media (max-width: 700px) { .cmp { display: none; } }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>
