---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import About from '../../components/beach/About.astro';
import Routes from '../../components/beach/Routes.astro';
import Todo from '../../components/beach/Todo.astro';
import Seasons from '../../components/home/Seasons.astro';
import Faq from '../../components/home/Faq.astro';
import FinalCta from '../../components/home/FinalCta.astro';
import site from '../../data/site.json';
import b from '../../data/beach.json';

const url = `${site.url}/plyazh-bai-dai/`;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Beach', '@id': `${url}#beach`, name: 'Пляж Бай Дай (Bãi Dài)', alternateName: ['Бай Зай', 'Bai Dai', 'Long Beach'],
      description: 'Песчаный пляж около 15 км между Нячангом и Камранью, около 20 км от центра Нячанга и 15 км от аэропорта Камрань.',
      address: { '@type': 'PostalAddress', addressLocality: 'Cam Lâm', addressRegion: 'Khánh Hòa', addressCountry: 'VN' },
      geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng }, hasMap: site.mapsUrl, url,
      containsPlace: { '@id': `${site.url}/#school` } },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Пляж Бай Дай', item: url },
    ] },
    { '@type': 'FAQPage', mainEntity: b.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ],
};
---
<Base
  title="Пляж Бай Дай (Бай Зай) в Нячанге и Камрани — как добраться и что делать | Tortuga"
  description="Пляж Бай Дай между Нячангом и Камранью: как добраться на Grab, байке, автобусе № 18 или трансфером школы, время в пути и цены, карта, тень, душ, купание с детьми."
  jsonld={jsonld}
>
  <link slot="head" rel="preload" as="image" href="/img/bg-beach.webp">
  <PageHero
    img="/img/bg-beach.webp"
    alt="Песчаный пляж с волнами и зелёными холмами"
    crumbs={[{ label: 'Пляж Бай Дай' }]}
    title={[{ text: 'Пляж Бай Дай' }, { text: 'в Нячанге:', light: true }, { text: 'как добраться' }]}
    lead="Бай Дай, Бай Зай, Bai Dai, Bãi Dài — всё это один пляж между Нячангом и Камранью. Рассказываем, как доехать из города и аэропорта, сколько это стоит и чем заняться на месте."
    facts={b.facts as [string, string][]}
  >
    <div class="btns">
      <a class="btn btn--primary" href="#kak-dobratsya">Как добраться</a>
      <a class="btn btn--ghost" href={site.mapsUrl} target="_blank" rel="noopener">Открыть на карте</a>
    </div>
  </PageHero>
  <About />
  <Routes />
  <Todo />
  <Seasons />
  <Faq items={b.faq} more={{ label: 'все вопросы о серфинге и планктоне', href: '/faq/' }} />
  <FinalCta img="/img/bg-aerial.webp" light="Нужен трансфер?" bold="Заберём из отеля" />
</Base>
