---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Intro from '../../components/courses/Intro.astro';
import Levels from '../../components/courses/Levels.astro';
import Glossary from '../../components/courses/Glossary.astro';
import SurfQuiz from '../../components/SurfQuiz.astro';
import Riders from '../../components/home/Riders.astro';
import Seasons from '../../components/home/Seasons.astro';
import Reviews from '../../components/home/Reviews.astro';
import Faq from '../../components/home/Faq.astro';
import FinalCta from '../../components/home/FinalCta.astro';
import { bot } from '../../lib/bot';
import site from '../../data/site.json';
import prices from '../../data/prices.json';
import courses from '../../data/courses.json';

const url = `${site.url}/kursy-serfinga/`;
const offers = prices.courses.map((c) => ({ '@type': 'Offer', name: `Курс ${c.name}`, price: c.vnd.replace(/\s/g, ''), priceCurrency: 'VND' }));
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Service', '@id': `${url}#service`, name: 'Курсы серфинга для продолжающих', serviceType: 'Обучение серфингу',
      description: 'Курсы серфинга на пляже Бай Дай для тех, кто уже вставал на доску: уроки в группе, аренда доски для самостоятельной практики, сёрфскейт и видеоразбор.',
      provider: { '@id': `${site.url}/#school` }, areaServed: ['Нячанг', 'Камрань'], url, offers },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Уроки серфинга', item: `${site.url}/uroki-serfinga/` },
      { '@type': 'ListItem', position: 3, name: 'Курсы для продолжающих', item: url },
    ] },
    { '@type': 'FAQPage', mainEntity: courses.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ],
};
const min = prices.courses[0];
---
<Base
  title="Курсы серфинга в Нячанге для продолжающих — уроки, аренда доски и сёрфскейт | Tortuga"
  description="Курсы серфинга на пляже Бай Дай: Holiday Surf, Surf Junior, Стань PRO и Ocean Guru. Уроки в группе, аренда доски для самостоятельной практики, сёрфскейт и видеоразбор."
  ogImage={`${site.url}/img/h-kursy.webp`}
  jsonld={jsonld}
>
  <link slot="head" rel="preload" as="image" href="/img/h-kursy.webp">
  <PageHero
    img="/img/h-kursy.webp"
    alt="Двое сёрферов в гидрокостюмах идут по кромке воды с досками"
    crumbs={[{ label: 'Уроки серфинга', href: '/uroki-serfinga/' }, { label: 'Курсы для продолжающих' }]}
    title={[{ text: 'Курсы серфинга' }, { text: 'для продолжающих', light: true }]}
    lead="Для тех, кто уже вставал на доску: уроки в группе плюс дни самостоятельной практики, чтобы выйти на лайн-ап, научиться поворачивать и ехать вдоль волны."
    facts={[
      ['4 курса', 'от 3 до 10 уроков'],
      [`от ${min.vnd} ₫`, `≈ $${min.usd} — ${min.name}`],
      ['Аренда доски', 'дни самостоятельной практики'],
      ['Сёрфскейт', 'и видеоразбор в старших курсах'],
    ]}
  >
    <div class="btns">
      <a class="btn btn--primary" href="#podbor-kursa">Подобрать курс</a>
      <a class="btn btn--ghost" href={bot('courses')} target="_blank" rel="noopener" data-goal="tg_courses_hero">Написать в Telegram</a>
    </div>
  </PageHero>
  <Intro />
  <SurfQuiz id="podbor-kursa" rail="Какой курс подходит" bold="Какой курс" light="вам подходит" level="some" />
  <Levels />
  <Riders img="/img/kursy-sami.webp" alt="База школы: навесы, доски и мотобайки под деревьями" flip={false} />
  <Glossary />
  <Seasons />
  <Reviews />
  <Faq items={courses.faq} more={{ label: 'все вопросы о серфинге и планктоне', href: '/faq/' }} />
  <FinalCta quiz="/#quiz" botCode="courses" img="/img/cta-kursy.webp" />
</Base>
