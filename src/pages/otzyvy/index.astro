---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Videos from '../../components/reviews/Videos.astro';
import TextReviews from '../../components/reviews/TextReviews.astro';
import Platforms from '../../components/reviews/Platforms.astro';
import FinalCta from '../../components/home/FinalCta.astro';
import site from '../../data/site.json';
import reviews from '../../data/reviews.json';

const url = `${site.url}/otzyvy/`;
const items = reviews.items as { name: string; date: string; rating?: number; text: string }[];
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Отзывы', item: url },
    ] },
    // Review markup only for real written reviews (src/data/reviews.json)
    ...(items.length ? [{ '@type': 'SportsActivityLocation', '@id': `${site.url}/#school`, name: site.name,
      review: items.map((r) => ({ '@type': 'Review', author: { '@type': 'Person', name: r.name }, datePublished: r.date, reviewBody: r.text,
        ...(r.rating ? { reviewRating: { '@type': 'Rating', ratingValue: r.rating, bestRating: 5 } } : {}) })) }] : []),
  ],
};
---
<Base
  title="Отзывы о школе серфинга Tortuga в Нячанге — уроки и светящийся планктон"
  description="Отзывы гостей о первом уроке серфинга и ночной экскурсии к светящемуся планктону на пляже Бай Дай: видео и отзывы из Google Карт, Яндекс Карт и TripAdvisor."
  jsonld={jsonld}
>
  <PageHero
    compact
    img="/img/ph-couple.webp"
    alt="Пара с доской для серфинга на закате"
    crumbs={[{ label: 'Отзывы' }]}
    title={[{ text: 'Отзывы' }, { text: 'гостей Tortuga', light: true }]}
    lead="Только настоящие отзывы: видео гостей и отзывы из Google Карт, Яндекс Карт и TripAdvisor — без правок по смыслу."
  >
    <div class="btns">
      <a class="btn btn--primary" href="#video">Смотреть видео</a>
      <a class="btn btn--ghost" href="#texts">Читать отзывы</a>
    </div>
  </PageHero>
  <Videos />
  <TextReviews />
  <Platforms />
  <FinalCta quiz="/#quiz" light="Хотите так же?" bold="Запишитесь на урок" />
</Base>
