---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import FaqList from '../../components/faq/FaqList.astro';
import FinalCta from '../../components/home/FinalCta.astro';
import site from '../../data/site.json';
import { faqGroups } from '../../lib/faq';

const groups = faqGroups();
const total = groups.reduce((n, g) => n + g.items.length, 0);
const plural = (n: number) => (n % 10 === 1 && n % 100 !== 11 ? 'ответ' : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? 'ответа' : 'ответов');
const url = `${site.url}/faq/`;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'FAQPage', '@id': `${url}#faq`, url,
      mainEntity: groups.flatMap((g) => g.items.map((f) => ({ '@type': 'Question', name: f.q, url: `${url}#${f.id}`, acceptedAnswer: { '@type': 'Answer', text: f.a } }))) },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Вопросы и ответы', item: url },
    ] },
  ],
};
---
<Base
  title="Частые вопросы — уроки серфинга и светящийся планктон в Нячанге | Tortuga"
  description="Нужно ли уметь плавать, сколько уроков нужно, с какого возраста, кусается ли светящийся планктон, что входит в цену, как оплатить и добраться до пляжа Бай Дай — ответы школы Tortuga."
  jsonld={jsonld}
>
  <PageHero
    compact
    img="/img/ph-beachrest.webp"
    alt="Отдых на пляже после урока серфинга"
    crumbs={[{ label: 'Вопросы и ответы' }]}
    title={[{ text: 'Вопросы' }, { text: 'о серфинге и экскурсии', light: true }]}
    lead={`${total} ${plural(total)} школы: уроки и курсы, дети, светящийся планктон, оплата, трансфер и пляж Бай Дай. Не нашли свой вопрос — напишите, ответим ${site.hours} по времени Нячанга.`}
  />
  <FaqList groups={groups} />
  <FinalCta quiz="/#quiz" light="Остались вопросы?" bold="Напишите нам" waText="Здравствуйте! У меня вопрос: " />
</Base>
